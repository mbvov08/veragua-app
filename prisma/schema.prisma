// Prisma schema — Veragua App
// Dev: SQLite (file:./dev.db). Prod: switch provider to "postgresql" + DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  role         String // "ADMIN" | "EMPLEADA" | "GALPON"
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  timeEntries        TimeEntry[]
  ordersCreated      Order[]              @relation("OrderCreatedBy")
  recurringRules     RecurringOrderRule[] @relation("RecurringRuleCreatedBy")
  tasksAssigned      Task[]               @relation("TaskAssignee")
  tasksCreated       Task[]               @relation("TaskCreatedBy")
  reminderRules      ReminderRule[]       @relation("ReminderRuleCreatedBy")
  reminderDismissals ReminderDismissal[]
  payrollSlips       PayrollSlip[]
  liquidaciones      Liquidacion[]
  primaPagos         PrimaPago[]
  cesantiasConsignaciones CesantiasConsignacion[]
  employeeProfile    EmployeeProfile?
  registrosGalpon    RegistroGalpon[]
  recepcionesLocal   RecepcionLocal[]     @relation("RecepcionRegistradaPor")
  pagosGalpon        PagoGalpon[]
  listasCompras      ListaCompras[]
  cajaMovimientosCreados  CajaMovimiento[] @relation("CajaCreadoPor")
  cajaMovimientosAprobados CajaMovimiento[] @relation("CajaAprobadoPor")
  melcochProduccionesCreadas MelcochProduccionDiaria[] @relation("MelcochProduccionCreadaPor")
  melcochComprasCreadas      MelcochCompraIngrediente[] @relation("MelcochCompraCreadaPor")
  melcochAjustesCreados      MelcochAjusteInventario[]  @relation("MelcochAjusteCreadoPor")
  productosCreados           Producto[]                 @relation("ProductoCreadoPor")
}

// Lista de referencia de productos que se venden, para agilizar la toma de pedidos.
// No lleva inventario ni cantidades, solo el nombre.
model Producto {
  id          String   @id @default(cuid())
  nombre      String   @unique
  creadoPorId String
  creadoPor   User     @relation("ProductoCreadoPor", fields: [creadoPorId], references: [id])
  createdAt   DateTime @default(now())
}

// Día fijo de la semana en que sale cada ruta (Pereira, Manizales), ya que solo se hacen una vez por semana.
model RutaSettings {
  id        String @id @default(cuid())
  zona      String @unique // "PEREIRA" | "MANIZALES"
  diaSemana Int // 0=domingo .. 6=sábado
}

// Datos laborales del empleado usados para nómina y liquidación
model EmployeeProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id])
  cedula               String?
  salarioBase          Float    @default(0)
  fechaIngreso         DateTime
  auxTransporte        Boolean  @default(true)
  // Extra fijo que se paga cada quincena por fuera del salario (ej. domicilios),
  // no constitutivo de salario: no se le calcula salud/pensión.
  extraQuincenal       Float    @default(0)
  extraQuincenalLabel  String   @default("Domicilios")
  updatedAt            DateTime @updatedAt
}

// Ajustes generales de nómina (SMLMV, auxilio de transporte, porcentajes de ley)
model PayrollSettings {
  id                    String   @id @default("singleton")
  smlmv                 Float
  auxilioTransporte     Float
  porcentajeSalud       Float    @default(0.04)
  porcentajePension     Float    @default(0.04)
  horasSemanaLegal      Float    @default(42)
  // Divisor de horas mensuales para el valor de la hora ordinaria (referencia oficial vigente: 220).
  divisorHorasMensual   Float    @default(220)
  topeAuxTransporteSmlmv Float   @default(2)
  // Pago por cubeta (30 huevos) en buen estado, para el encargado del galpón.
  valorCubetaGalpon     Float    @default(1000)
  huevosPorCubeta       Int      @default(30)
  updatedAt             DateTime @updatedAt
}

// Registro diario del encargado del galpón: cuántos huevos produjo y cuántos salieron rotos.
model RegistroGalpon {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  fecha          DateTime // UTC-noon normalizado
  huevosProducidos Int
  huevosRotos    Int      @default(0)
  observaciones  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, fecha])
  @@index([fecha])
}

// Registro diario de cuántos huevos ingresaron efectivamente al local (lo entrega Daniela/admin).
model RecepcionLocal {
  id             String   @id @default(cuid())
  fecha          DateTime @unique // UTC-noon normalizado
  cantidadRecibida Int
  observaciones  String?
  registradoPorId String
  registradoPor  User     @relation("RecepcionRegistradaPor", fields: [registradoPorId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([fecha])
}

// Pago al encargado del galpón por producción, cruzando su registro con lo recibido en el local.
model PagoGalpon {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  periodStart        DateTime
  periodEnd          DateTime
  huevosProducidos   Int
  huevosRotos        Int
  huevosRecibidosLocal Int
  huevosVerificados  Int
  cubetas            Float
  valorCubeta        Float
  totalPagar         Float
  detalleJson        String
  generadoPorId      String
  generatedAt        DateTime @default(now())

  @@index([userId, periodStart])
}

model TimeEntry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  workDate  DateTime // día lógico (UTC-noon normalizado)
  clockIn   DateTime
  clockOut  DateTime?
  notas     String?
  // Si la salida fue después de la jornada ordinaria, motivo y justificación obligatorios.
  motivoSalidaTardia  String? // "CARGA_TRABAJO" | "INGRESO_TARDE_COMPENSO" | "ALMUERZO_EXTENDIDO" | "COMPROMISO_PERSONAL" | "OTRO"
  esJustificable      Boolean? // autoevaluación de quien marca la salida
  justificacionSalida String?
  createdAt DateTime  @default(now())

  @@unique([userId, workDate])
  @@index([userId, workDate])
}

model Order {
  id              String    @id @default(cuid())
  cliente         String
  direccion       String
  telefono        String?
  zona            String // "LOCAL" | "PEREIRA" | "MANIZALES"
  fechaEntrega    DateTime // UTC-noon normalizado
  entregado       Boolean   @default(false)
  entregadoAt     DateTime?
  notas           String?
  recurringRuleId String?
  recurringRule   RecurringOrderRule? @relation(fields: [recurringRuleId], references: [id])
  creadoPorId     String
  creadoPor       User      @relation("OrderCreatedBy", fields: [creadoPorId], references: [id])
  createdAt       DateTime  @default(now())

  @@unique([recurringRuleId, fechaEntrega])
  @@index([zona, fechaEntrega])
}

model RecurringOrderRule {
  id          String   @id @default(cuid())
  cliente     String
  direccion   String
  telefono    String?
  zona        String
  diaSemana   Int // 0=domingo .. 6=sábado
  notas       String?
  activo      Boolean  @default(true)
  creadoPorId String
  creadoPor   User     @relation("RecurringRuleCreatedBy", fields: [creadoPorId], references: [id])
  createdAt   DateTime @default(now())

  orders Order[]
}

model Task {
  id             String    @id @default(cuid())
  titulo         String
  descripcion    String?
  asignadoAId    String
  asignadoA      User      @relation("TaskAssignee", fields: [asignadoAId], references: [id])
  creadoPorId    String
  creadoPor      User      @relation("TaskCreatedBy", fields: [creadoPorId], references: [id])
  fechaTentativa DateTime? // meta blanda: cuándo debería estar lista
  fechaLimite    DateTime? // fecha límite dura: no se puede pasar de esta fecha
  estado         String    @default("PENDIENTE") // PENDIENTE | EN_PROCESO | COMPLETADO
  esProyecto     Boolean   @default(false) // true = tiene fases (subtareas) y se sigue por progreso
  proyectoId     String?
  proyecto       Task?     @relation("ProyectoFases", fields: [proyectoId], references: [id])
  fases          Task[]    @relation("ProyectoFases")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ReminderRule {
  id          String   @id @default(cuid())
  titulo      String
  mensaje     String?
  diaSemana   Int // 0=domingo .. 6=sábado
  activo      Boolean  @default(true)
  creadoPorId String
  creadoPor   User     @relation("ReminderRuleCreatedBy", fields: [creadoPorId], references: [id])
  createdAt   DateTime @default(now())

  instances ReminderInstance[]
}

model ReminderInstance {
  id             String   @id @default(cuid())
  reminderRuleId String
  reminderRule   ReminderRule @relation(fields: [reminderRuleId], references: [id])
  fecha          DateTime // UTC-noon normalizado
  createdAt      DateTime @default(now())

  dismissals ReminderDismissal[]

  @@unique([reminderRuleId, fecha])
  @@index([fecha])
}

model ReminderDismissal {
  id                 String           @id @default(cuid())
  reminderInstanceId String
  reminderInstance   ReminderInstance @relation(fields: [reminderInstanceId], references: [id])
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  dismissedAt        DateTime         @default(now())

  @@unique([reminderInstanceId, userId])
}

model PayrollSlip {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  periodStart      DateTime
  periodEnd        DateTime
  salarioBase      Float
  diasTrabajados   Float
  horasOrdinarias  Float
  horasExtraDiu    Float
  horasExtraNoc    Float
  valorExtraDiu    Float
  valorExtraNoc    Float
  // Horas extra según la autoevaluación al marcar salida tardía.
  horasJustificadas   Float @default(0)
  horasNoJustificadas Float @default(0)
  extraFijo        Float    @default(0)
  extraFijoLabel   String?
  auxTransporte    Float
  totalDevengado   Float
  saludDeduccion   Float
  pensionDeduccion Float
  totalDeducciones Float
  // Descuento por faltante/pérdida asumida por la empleada (pactado en su contrato). Manual, con concepto.
  descuentoFaltante        Float @default(0)
  descuentoFaltanteConcepto String?
  netoPagar        Float
  detalleJson      String
  generadoPorId    String
  generatedAt      DateTime @default(now())

  @@index([userId, periodStart])
}

model Liquidacion {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  fechaIngreso        DateTime
  fechaRetiro         DateTime
  salarioBase         Float
  diasLaborados       Int
  cesantias           Float
  interesesCesantias  Float
  prima               Float
  vacaciones          Float
  totalLiquidacion    Float
  detalleJson         String
  generadoPorId       String
  generatedAt         DateTime @default(now())
}

// Prima de servicios: por ley se paga dos veces al año (30 de junio y 20 de diciembre)
// a todo empleado activo, independiente de la liquidación.
model PrimaPago {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  semestre       Int // 1 o 2
  anio           Int
  semestreInicio DateTime
  semestreFin    DateTime
  salarioBase    Float
  diasBase       Int
  valorPrima     Float
  detalleJson    String
  generadoPorId  String
  generatedAt    DateTime @default(now())

  @@unique([userId, anio, semestre])
}

// Cálculo informativo de cuánto consignar al fondo de cesantías antes del 14 de febrero.
model CesantiasConsignacion {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  anio               Int
  salarioBase        Float
  diasBase           Int
  valorCesantias     Float
  valorIntereses     Float
  detalleJson        String
  generadoPorId      String
  generatedAt        DateTime @default(now())

  @@unique([userId, anio])
}

// Lista de compras/insumos pendientes, separada por área (galpón o local).
// Cada área solo ve y crea lo suyo; la administradora ve ambas.
model ListaCompras {
  id           String    @id @default(cuid())
  item         String
  cantidad     String?
  categoria    String // "GALPON" | "LOCAL"
  comprado     Boolean   @default(false)
  compradoAt   DateTime?
  creadoPorId  String
  creadoPor    User      @relation(fields: [creadoPorId], references: [id])
  createdAt    DateTime  @default(now())

  @@index([categoria, comprado])
}

// Ajustes de caja: base inicial de efectivo. Solo administradora y empleada del local acceden.
model CajaSettings {
  id          String   @id @default("singleton")
  baseInicial Float    @default(0)
  updatedAt   DateTime @updatedAt
}

// Movimientos de caja (efectivo). Los egresos deben ser aprobados por la administradora
// antes de contar contra el saldo; los ingresos (base/reposición) los registra ella directamente.
model CajaMovimiento {
  id             String    @id @default(cuid())
  tipo           String // "INGRESO" | "EGRESO"
  monto          Float
  categoria      String? // solo para egresos
  estado         String    @default("APROBADO") // "PENDIENTE" | "APROBADO" | "RECHAZADO"
  observaciones  String?
  fecha          DateTime // UTC-noon normalizado
  creadoPorId    String
  creadoPor      User      @relation("CajaCreadoPor", fields: [creadoPorId], references: [id])
  aprobadoPorId  String?
  aprobadoPor    User?     @relation("CajaAprobadoPor", fields: [aprobadoPorId], references: [id])
  createdAt      DateTime  @default(now())

  @@index([tipo, estado])
}

// Línea Melcoch — Brownie de Milo. Ingredientes fijos con su cantidad por mezcla (receta).
model MelcochIngrediente {
  id                String   @id @default(cuid())
  nombre            String   @unique
  unidad            String // "g" | "unidad"
  cantidadPorMezcla Float

  compras  MelcochCompraIngrediente[]
  ajustes  MelcochAjusteInventario[]
}

// Producción diaria: cuántas mezclas se hicieron (consume ingredientes automáticamente)
// y cómo se empacó (informativo). Daniela no ve el saldo resultante, solo registra.
model MelcochProduccionDiaria {
  id              String   @id @default(cuid())
  fecha           DateTime @unique // UTC-noon normalizado
  mezclas         Float
  cajasNormales   Int      @default(0)
  cajasFamiliares Int      @default(0)
  observaciones   String?
  creadoPorId     String
  creadoPor       User     @relation("MelcochProduccionCreadaPor", fields: [creadoPorId], references: [id])
  createdAt       DateTime @default(now())
}

// Compras/reposición de un ingrediente (incluye el inventario inicial, como primera compra).
model MelcochCompraIngrediente {
  id             String             @id @default(cuid())
  ingredienteId  String
  ingrediente    MelcochIngrediente @relation(fields: [ingredienteId], references: [id])
  cantidad       Float
  fecha          DateTime
  observaciones  String?
  creadoPorId    String
  creadoPor      User               @relation("MelcochCompraCreadaPor", fields: [creadoPorId], references: [id])
  createdAt      DateTime           @default(now())
}

// Conteo físico sorpresa (solo administradora): ajusta el saldo teórico al real y deja
// registrada la diferencia (merma o sobrante) para ese ingrediente.
model MelcochAjusteInventario {
  id             String             @id @default(cuid())
  ingredienteId  String
  ingrediente    MelcochIngrediente @relation(fields: [ingredienteId], references: [id])
  teoricoAntes   Float
  contado        Float
  diferencia     Float
  fecha          DateTime
  creadoPorId    String
  creadoPor      User               @relation("MelcochAjusteCreadoPor", fields: [creadoPorId], references: [id])
  createdAt      DateTime           @default(now())
}
