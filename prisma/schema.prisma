// Prisma schema — Veragua App
// Dev: SQLite (file:./dev.db). Prod: switch provider to "postgresql" + DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String   @id @default(cuid())
  username         String   @unique
  name             String
  passwordHash     String
  role             String // "ADMIN" | "EMPLEADA" | "GALPON"
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  // Acceso al módulo Finanzas sin necesidad de ser ADMIN (ej. Daniela).
  puedeVerFinanzas Boolean  @default(false)

  timeEntries                 TimeEntry[]
  ordersCreated               Order[]                    @relation("OrderCreatedBy")
  recurringRules              RecurringOrderRule[]       @relation("RecurringRuleCreatedBy")
  tasksAssigned               Task[]                     @relation("TaskAssignee")
  tasksCreated                Task[]                     @relation("TaskCreatedBy")
  reminderRules               ReminderRule[]             @relation("ReminderRuleCreatedBy")
  reminderDismissals          ReminderDismissal[]
  payrollSlips                PayrollSlip[]
  liquidaciones               Liquidacion[]
  primaPagos                  PrimaPago[]
  cesantiasConsignaciones     CesantiasConsignacion[]
  employeeProfile             EmployeeProfile?
  registrosGalpon             RegistroGalpon[]
  recepcionesLocal            RecepcionLocal[]           @relation("RecepcionRegistradaPor")
  pagosGalpon                 PagoGalpon[]
  listasCompras               ListaCompras[]
  cajaMovimientosCreados      CajaMovimiento[]           @relation("CajaCreadoPor")
  cajaMovimientosAprobados    CajaMovimiento[]           @relation("CajaAprobadoPor")
  melcochProduccionesCreadas  MelcochProduccionDiaria[]  @relation("MelcochProduccionCreadaPor")
  melcochComprasCreadas       MelcochCompraIngrediente[] @relation("MelcochCompraCreadaPor")
  melcochAjustesCreados       MelcochAjusteInventario[]  @relation("MelcochAjusteCreadoPor")
  productosCreados            Producto[]                 @relation("ProductoCreadoPor")
  finTransactionsCreadas      FinTransaction[]           @relation("FinTransactionCreadaPor")
  finTransactionsAnuladas     FinTransaction[]           @relation("FinTransactionAnuladaPor")
  finImportBatches            FinImportBatch[]           @relation("FinImportBatchImportadoPor")
  finCategoriasCreadas        FinCategory[]              @relation("FinCategoryCreadaPor")
  pushSubscriptions           PushSubscription[]
  finProductosCreados         FinProduct[]               @relation("FinProductCreadoPor")
  finInventoryAjustesCreados  FinInventoryAdjustment[]   @relation("FinInventoryAdjustmentCreadoPor")
  finComprasCreadas           FinPurchase[]              @relation("FinPurchaseCreadoPor")
  finVentasCreadas            FinSale[]                  @relation("FinSaleCreadoPor")
  finCxCCreadas               FinCuentaPorCobrar[]       @relation("FinCxCCreadoPor")
  finCxPCreadas               FinCuentaPorPagar[]        @relation("FinCxPCreadoPor")
  finPagosClienteCreados      FinPagoCliente[]           @relation("FinPagoClienteCreadoPor")
  finPagosProveedorCreados    FinPagoProveedor[]         @relation("FinPagoProveedorCreadoPor")
  suscripcionesCreadas        Suscripcion[]              @relation("SuscripcionCreadaPor")
  cajaCierresCreados          CajaCierre[]               @relation("CajaCierreCreadoPor")
  vehiculoSalidasConductor    VehiculoSalida[]           @relation("VehiculoSalidaConductor")
  vehiculoSalidasCheckoutPor  VehiculoSalida[]           @relation("VehiculoCheckoutPor")
  vehiculoSalidasCheckinPor   VehiculoSalida[]           @relation("VehiculoCheckinPor")
  vehiculoArchivosSubidos     VehiculoArchivo[]          @relation("VehiculoArchivoSubidoPor")
  vehiculoRecibosSubidos      VehiculoRecibo[]           @relation("VehiculoReciboSubidoPor")
  vehiculoDaniosComoConductor VehiculoDanioFinanciero[]  @relation("VehiculoDanioConductor")
  vehiculoDaniosCreados       VehiculoDanioFinanciero[]  @relation("VehiculoDanioCreadoPor")
  vehiculoParadasCompletadas  VehiculoParada[]           @relation("VehiculoParadaCompletadaPor")
}

// Lista de referencia de productos que se venden, para agilizar la toma de pedidos.
// No lleva inventario ni cantidades, solo el nombre.
model Producto {
  id          String                   @id @default(cuid())
  nombre      String                   @unique
  categoria   String                   @default("Otros")
  creadoPorId String
  creadoPor   User                     @relation("ProductoCreadoPor", fields: [creadoPorId], references: [id])
  createdAt   DateTime                 @default(now())
  ordenados   OrderItem[]
  reglaItems  RecurringOrderRuleItem[]
}

// Día fijo de la semana en que sale cada ruta (Pereira, Manizales), ya que solo se hacen una vez por semana.
model RutaSettings {
  id        String @id @default(cuid())
  zona      String @unique // "PEREIRA" | "MANIZALES"
  diaSemana Int // 0=domingo .. 6=sábado
}

// Datos laborales del empleado usados para nómina y liquidación
model EmployeeProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  cedula              String?
  salarioBase         Float    @default(0)
  fechaIngreso        DateTime
  auxTransporte       Boolean  @default(true)
  // Extra fijo que se paga cada quincena por fuera del salario (ej. domicilios),
  // no constitutivo de salario: no se le calcula salud/pensión.
  extraQuincenal      Float    @default(0)
  extraQuincenalLabel String   @default("Domicilios")
  updatedAt           DateTime @updatedAt
}

// Ajustes generales de nómina (SMLMV, auxilio de transporte, porcentajes de ley)
model PayrollSettings {
  id                     String   @id @default("singleton")
  smlmv                  Float
  auxilioTransporte      Float
  porcentajeSalud        Float    @default(0.04)
  porcentajePension      Float    @default(0.04)
  horasSemanaLegal       Float    @default(42)
  // Divisor de horas mensuales para el valor de la hora ordinaria (referencia oficial vigente: 220).
  divisorHorasMensual    Float    @default(220)
  topeAuxTransporteSmlmv Float    @default(2)
  // Pago por cubeta (30 huevos) en buen estado, para el encargado del galpón.
  valorCubetaGalpon      Float    @default(1000)
  huevosPorCubeta        Int      @default(30)
  updatedAt              DateTime @updatedAt
}

// Registro diario del encargado del galpón: cuántos huevos produjo y cuántos salieron rotos.
model RegistroGalpon {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  fecha            DateTime // UTC-noon normalizado
  huevosProducidos Int
  huevosRotos      Int      @default(0)
  observaciones    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, fecha])
  @@index([fecha])
}

// Registro diario de cuántos huevos ingresaron efectivamente al local (lo entrega Daniela/admin).
model RecepcionLocal {
  id               String   @id @default(cuid())
  fecha            DateTime @unique // UTC-noon normalizado
  cantidadRecibida Int
  observaciones    String?
  registradoPorId  String
  registradoPor    User     @relation("RecepcionRegistradaPor", fields: [registradoPorId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([fecha])
}

// Pago al encargado del galpón por producción, cruzando su registro con lo recibido en el local.
model PagoGalpon {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  periodStart          DateTime
  periodEnd            DateTime
  huevosProducidos     Int
  huevosRotos          Int
  huevosRecibidosLocal Int
  huevosVerificados    Int
  cubetas              Float
  valorCubeta          Float
  totalPagar           Float
  detalleJson          String
  generadoPorId        String
  generatedAt          DateTime @default(now())

  @@index([userId, periodStart])
}

model TimeEntry {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  workDate            DateTime // día lógico (UTC-noon normalizado)
  clockIn             DateTime
  clockOut            DateTime?
  notas               String?
  // Si la salida fue después de la jornada ordinaria, motivo y justificación obligatorios.
  motivoSalidaTardia  String? // "CARGA_TRABAJO" | "INGRESO_TARDE_COMPENSO" | "ALMUERZO_EXTENDIDO" | "COMPROMISO_PERSONAL" | "OTRO"
  esJustificable      Boolean? // autoevaluación de quien marca la salida
  justificacionSalida String?
  createdAt           DateTime  @default(now())

  @@unique([userId, workDate])
  @@index([userId, workDate])
}

// Registro de clientes: al escribir un nombre ya usado, dirección/teléfono/zona
// se autocompletan. Se guarda/actualiza automáticamente al crear o editar un pedido.
model Cliente {
  id        String   @id @default(cuid())
  nombre    String   @unique
  direccion String
  telefono  String?
  zona      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ventas           FinSale[]
  cuentasPorCobrar FinCuentaPorCobrar[]
  pagos            FinPagoCliente[]
  suscripciones    Suscripcion[]
}

model Order {
  id              String              @id @default(cuid())
  cliente         String
  direccion       String
  telefono        String?
  zona            String // "LOCAL" | "PEREIRA" | "MANIZALES"
  fechaEntrega    DateTime // UTC-noon normalizado
  entregado       Boolean             @default(false)
  entregadoAt     DateTime?
  notas           String?
  items           OrderItem[]
  recurringRuleId String?
  recurringRule   RecurringOrderRule? @relation(fields: [recurringRuleId], references: [id])
  creadoPorId     String
  creadoPor       User                @relation("OrderCreatedBy", fields: [creadoPorId], references: [id])
  createdAt       DateTime            @default(now())

  // Cuando un conductor marca el pedido como entregado desde el módulo Vehículo:
  // qué salida lo entregó, y la foto de la remisión firmada.
  vehiculoSalidaId String?
  vehiculoSalida   VehiculoSalida?  @relation(fields: [vehiculoSalidaId], references: [id])
  entregaArchivoId String?
  entregaArchivo   VehiculoArchivo? @relation(fields: [entregaArchivoId], references: [id])

  // Si no es null, el pedido lo entrega un tercero (ej. "Hato Azul") directamente al
  // cliente — se cobró/vendió con nosotros, pero no sale de nuestro inventario ni lo
  // reparte nuestro vehículo. Por eso no debe aparecer en "Pedidos del día" del módulo
  // Vehículo, solo queda visible en Calendario y como referencia aquí.
  entregaTercero String?

  @@unique([recurringRuleId, fechaEntrega])
  @@index([zona, fechaEntrega])
  @@index([vehiculoSalidaId])
}

// Producto pedido dentro de un pedido puntual. Sin inventario: solo referencia qué y cuánto se pidió.
model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   String? // texto libre, ej. "1 cubeta", "2"
  createdAt  DateTime @default(now())
}

model RecurringOrderRule {
  id             String    @id @default(cuid())
  cliente        String
  direccion      String
  telefono       String?
  zona           String
  diaSemana      Int // 0=domingo .. 6=sábado
  notas          String?
  activo         Boolean   @default(true)
  // Si no es null, no se generan pedidos con fechaEntrega posterior a esta fecha
  // (se usa para suscripciones mensuales: la entrega recurrente para cuando vence).
  fechaFin       DateTime?
  // Igual que Order.entregaTercero: si no es null, cada pedido que genere esta regla
  // recurrente lo entrega ese tercero, no nuestro inventario/vehículo.
  entregaTercero String?
  creadoPorId    String
  creadoPor      User      @relation("RecurringRuleCreatedBy", fields: [creadoPorId], references: [id])
  createdAt      DateTime  @default(now())

  orders        Order[]
  items         RecurringOrderRuleItem[]
  suscripciones Suscripcion[]
}

// Plantilla de productos que se copia a cada pedido generado por la regla recurrente,
// para no tener que volver a escribirlos cada semana (ej. los productos de una suscripción).
model RecurringOrderRuleItem {
  id              String             @id @default(cuid())
  recurringRuleId String
  recurringRule   RecurringOrderRule @relation(fields: [recurringRuleId], references: [id])
  productoId      String
  producto        Producto           @relation(fields: [productoId], references: [id])
  cantidad        String?
  createdAt       DateTime           @default(now())
}

// Suscripción mensual: el cliente paga por adelantado y recibe entregas recurrentes
// (la RecurringOrderRule) hasta la fecha de vencimiento. Al vencer, se crea un
// recordatorio para preguntar si renueva.
model Suscripcion {
  id              String             @id @default(cuid())
  company         String
  clienteId       String
  cliente         Cliente            @relation(fields: [clienteId], references: [id])
  recurringRuleId String
  recurringRule   RecurringOrderRule @relation(fields: [recurringRuleId], references: [id])
  fechaInicio     DateTime
  fechaFin        DateTime
  montoPagado     Float
  metodoPago      String?
  estado          String             @default("activa") // "activa" | "cancelada"
  reminderRuleId  String?
  creadoPorId     String
  creadoPor       User               @relation("SuscripcionCreadaPor", fields: [creadoPorId], references: [id])
  createdAt       DateTime           @default(now())
}

model Task {
  id             String    @id @default(cuid())
  titulo         String
  descripcion    String?
  asignadoAId    String
  asignadoA      User      @relation("TaskAssignee", fields: [asignadoAId], references: [id])
  creadoPorId    String
  creadoPor      User      @relation("TaskCreatedBy", fields: [creadoPorId], references: [id])
  fechaTentativa DateTime? // meta blanda: cuándo debería estar lista
  fechaLimite    DateTime? // fecha límite dura: no se puede pasar de esta fecha
  estado         String    @default("PENDIENTE") // PENDIENTE | EN_PROCESO | COMPLETADO
  esProyecto     Boolean   @default(false) // true = tiene fases (subtareas) y se sigue por progreso
  proyectoId     String?
  proyecto       Task?     @relation("ProyectoFases", fields: [proyectoId], references: [id])
  fases          Task[]    @relation("ProyectoFases")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ReminderRule {
  id          String   @id @default(cuid())
  titulo      String
  mensaje     String?
  diaSemana   Int // 0=domingo .. 6=sábado
  activo      Boolean  @default(true)
  esUnico     Boolean  @default(false) // true = evento/fecha especial de una sola vez, no semanal
  creadoPorId String
  creadoPor   User     @relation("ReminderRuleCreatedBy", fields: [creadoPorId], references: [id])
  createdAt   DateTime @default(now())

  instances ReminderInstance[]
}

model ReminderInstance {
  id              String       @id @default(cuid())
  reminderRuleId  String
  reminderRule    ReminderRule @relation(fields: [reminderRuleId], references: [id])
  fecha           DateTime // UTC-noon normalizado
  createdAt       DateTime     @default(now())
  // Mensaje calculado para esta instancia puntual (ej. reabastecimiento: qué productos
  // tocan hoy), en vez del mensaje fijo de la regla. "" (string vacío, distinto de null)
  // significa "ya se generó hoy pero no hay nada que avisar" — evita recalcular en cada
  // carga de página sin mostrar una notificación vacía.
  mensajeOverride String?

  dismissals ReminderDismissal[]

  @@unique([reminderRuleId, fecha])
  @@index([fecha])
}

model ReminderDismissal {
  id                 String           @id @default(cuid())
  reminderInstanceId String
  reminderInstance   ReminderInstance @relation(fields: [reminderInstanceId], references: [id])
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  dismissedAt        DateTime         @default(now())

  @@unique([reminderInstanceId, userId])
}

model PayrollSlip {
  id                        String   @id @default(cuid())
  userId                    String
  user                      User     @relation(fields: [userId], references: [id])
  periodStart               DateTime
  periodEnd                 DateTime
  salarioBase               Float
  diasTrabajados            Float
  horasOrdinarias           Float
  horasExtraDiu             Float
  horasExtraNoc             Float
  valorExtraDiu             Float
  valorExtraNoc             Float
  // Horas extra según la autoevaluación al marcar salida tardía.
  horasJustificadas         Float    @default(0)
  horasNoJustificadas       Float    @default(0)
  extraFijo                 Float    @default(0)
  extraFijoLabel            String?
  auxTransporte             Float
  totalDevengado            Float
  saludDeduccion            Float
  pensionDeduccion          Float
  totalDeducciones          Float
  // Descuento por faltante/pérdida asumida por la empleada (pactado en su contrato). Manual, con concepto.
  descuentoFaltante         Float    @default(0)
  descuentoFaltanteConcepto String?
  netoPagar                 Float
  detalleJson               String
  generadoPorId             String
  generatedAt               DateTime @default(now())

  @@index([userId, periodStart])
}

model Liquidacion {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  fechaIngreso       DateTime
  fechaRetiro        DateTime
  salarioBase        Float
  diasLaborados      Int
  cesantias          Float
  interesesCesantias Float
  prima              Float
  vacaciones         Float
  totalLiquidacion   Float
  detalleJson        String
  generadoPorId      String
  generatedAt        DateTime @default(now())
}

// Prima de servicios: por ley se paga dos veces al año (30 de junio y 20 de diciembre)
// a todo empleado activo, independiente de la liquidación.
model PrimaPago {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  semestre       Int // 1 o 2
  anio           Int
  semestreInicio DateTime
  semestreFin    DateTime
  salarioBase    Float
  diasBase       Int
  valorPrima     Float
  detalleJson    String
  generadoPorId  String
  generatedAt    DateTime @default(now())

  @@unique([userId, anio, semestre])
}

// Cálculo informativo de cuánto consignar al fondo de cesantías antes del 14 de febrero.
model CesantiasConsignacion {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  anio           Int
  salarioBase    Float
  diasBase       Int
  valorCesantias Float
  valorIntereses Float
  detalleJson    String
  generadoPorId  String
  generatedAt    DateTime @default(now())

  @@unique([userId, anio])
}

// Lista de compras/insumos pendientes, separada por área (galpón o local).
// Cada área solo ve y crea lo suyo; la administradora ve ambas.
model ListaCompras {
  id          String    @id @default(cuid())
  item        String
  cantidad    String?
  categoria   String // "GALPON" | "LOCAL"
  comprado    Boolean   @default(false)
  compradoAt  DateTime?
  creadoPorId String
  creadoPor   User      @relation(fields: [creadoPorId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([categoria, comprado])
}

// Ajustes de caja: base inicial de efectivo. Solo administradora y empleada del local acceden.
model CajaSettings {
  id          String   @id @default("singleton")
  baseInicial Float    @default(0)
  updatedAt   DateTime @updatedAt
}

// Movimientos de caja (efectivo). Los egresos deben ser aprobados por la administradora
// antes de contar contra el saldo; los ingresos (base/reposición) los registra ella directamente.
model CajaMovimiento {
  id            String   @id @default(cuid())
  tipo          String // "INGRESO" | "EGRESO"
  monto         Float
  categoria     String? // solo para egresos
  estado        String   @default("APROBADO") // "PENDIENTE" | "APROBADO" | "RECHAZADO"
  observaciones String?
  fecha         DateTime // UTC-noon normalizado
  creadoPorId   String
  creadoPor     User     @relation("CajaCreadoPor", fields: [creadoPorId], references: [id])
  aprobadoPorId String?
  aprobadoPor   User?    @relation("CajaAprobadoPor", fields: [aprobadoPorId], references: [id])
  createdAt     DateTime @default(now())

  @@index([tipo, estado])
}

// Cierre de caja: cuenta el efectivo físico del local y lo compara contra lo que el
// sistema espera (CajaSettings.baseInicial, o el saldoContado del cierre anterior, más
// las ventas en efectivo menos los gastos pagados en efectivo desde ese cierre).
model CajaCierre {
  id               String   @id @default(cuid())
  fecha            DateTime // día que se cierra (UTC-noon normalizado)
  desde            DateTime // fecha/hora desde la que se calculó (el cierre anterior, o el inicio)
  saldoAnterior    Float // base inicial o saldoContado del cierre anterior
  ingresosEfectivo Float
  egresosEfectivo  Float
  saldoEsperado    Float // saldoAnterior + ingresosEfectivo - egresosEfectivo
  saldoContado     Float // lo que se contó físicamente
  diferencia       Float // saldoContado - saldoEsperado
  observaciones    String?
  creadoPorId      String
  creadoPor        User     @relation("CajaCierreCreadoPor", fields: [creadoPorId], references: [id])
  createdAt        DateTime @default(now())
}

// Línea Melcoch — Brownie de Milo. Ingredientes fijos con su cantidad por mezcla (receta).
model MelcochIngrediente {
  id                String @id @default(cuid())
  nombre            String @unique
  unidad            String // "g" | "unidad"
  cantidadPorMezcla Float

  compras MelcochCompraIngrediente[]
  ajustes MelcochAjusteInventario[]
}

// Producción diaria: cuántas mezclas se hicieron (consume ingredientes automáticamente)
// y cómo se empacó (informativo). Daniela no ve el saldo resultante, solo registra.
model MelcochProduccionDiaria {
  id              String   @id @default(cuid())
  fecha           DateTime @unique // UTC-noon normalizado
  mezclas         Float
  cajasNormales   Int      @default(0)
  cajasFamiliares Int      @default(0)
  // Las familiares se hacen en moldes distintos, no se cortan de una sola mezcla en
  // varias formas — por eso hay que saber cuál molde se usó para sumarle el stock al
  // producto correcto de Inventario ("CIRCULAR" | "CORAZON" | "CUADRADO").
  formaFamiliar   String?
  observaciones   String?
  creadoPorId     String
  creadoPor       User     @relation("MelcochProduccionCreadaPor", fields: [creadoPorId], references: [id])
  createdAt       DateTime @default(now())
}

// Compras/reposición de un ingrediente (incluye el inventario inicial, como primera compra).
model MelcochCompraIngrediente {
  id            String             @id @default(cuid())
  ingredienteId String
  ingrediente   MelcochIngrediente @relation(fields: [ingredienteId], references: [id])
  cantidad      Float
  fecha         DateTime
  observaciones String?
  creadoPorId   String
  creadoPor     User               @relation("MelcochCompraCreadaPor", fields: [creadoPorId], references: [id])
  createdAt     DateTime           @default(now())
}

// Conteo físico sorpresa (solo administradora): ajusta el saldo teórico al real y deja
// registrada la diferencia (merma o sobrante) para ese ingrediente.
model MelcochAjusteInventario {
  id            String             @id @default(cuid())
  ingredienteId String
  ingrediente   MelcochIngrediente @relation(fields: [ingredienteId], references: [id])
  teoricoAntes  Float
  contado       Float
  diferencia    Float
  fecha         DateTime
  creadoPorId   String
  creadoPor     User               @relation("MelcochAjusteCreadoPor", fields: [creadoPorId], references: [id])
  createdAt     DateTime           @default(now())
}

// ============================================================
// FINANZAS — migrado desde Veragua ERP (Siigo + Treinta ya importados).
// "company" es un campo de texto fijo ("VERAGUA" | "MELCOCH"), igual que
// ya se maneja Melcoch en el resto de este esquema: no existe un modelo
// Company genérico porque solo hay estas dos marcas.
// ============================================================

model FinChannel {
  id        String   @id @default(cuid())
  company   String // "VERAGUA" | "MELCOCH"
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  transacciones FinTransaction[]
  ventas        FinSale[]

  @@unique([company, nombre])
}

// Categorías estilo NIIF/PUC colombiano, simplificadas para uso gerencial.
// company null = compartida entre Veragua y Melcoch (el seed por defecto).
model FinCategory {
  id               String        @id @default(cuid())
  company          String?
  parentId         String?
  parent           FinCategory?  @relation("FinCategoryParent", fields: [parentId], references: [id])
  children         FinCategory[] @relation("FinCategoryParent")
  codigo           String
  nombre           String
  tipo             String // ingreso_operacional | ingreso_no_operacional | costo_venta | gasto_admin | gasto_ventas | gasto_no_operacional | impuesto
  atribuibleACanal Boolean       @default(true)
  creadoPorId      String?
  creadoPor        User?         @relation("FinCategoryCreadaPor", fields: [creadoPorId], references: [id])
  createdAt        DateTime      @default(now())

  transacciones FinTransaction[]

  @@unique([company, codigo])
}

// Trazabilidad de cada importación masiva (Siigo, Treinta, u otra futura).
model FinImportBatch {
  id             String   @id @default(cuid())
  company        String
  filename       String
  sourceLabel    String
  mappingJson    String?
  rowCount       Int      @default(0)
  importadoPorId String
  importadoPor   User     @relation("FinImportBatchImportadoPor", fields: [importadoPorId], references: [id])
  importedAt     DateTime @default(now())

  transacciones FinTransaction[]
}

// El corazón del módulo: cada ingreso y egreso de Veragua y Melcoch.
model FinTransaction {
  id            String          @id @default(cuid()) // en la migración inicial se reusan los UUID del ERP
  company       String // "VERAGUA" | "MELCOCH"
  tipo          String // "income" | "expense"
  fecha         DateTime // día calendario, mediodía UTC (dateOnlyToUTC)
  monto         Float
  categoriaId   String
  categoria     FinCategory     @relation(fields: [categoriaId], references: [id])
  canalId       String?
  canal         FinChannel?     @relation(fields: [canalId], references: [id])
  metodoPago    String?
  descripcion   String?
  contraparte   String?
  fuente        String          @default("manual") // "manual" | "import"
  importBatchId String?
  importBatch   FinImportBatch? @relation(fields: [importBatchId], references: [id])
  esReembolso   Boolean         @default(false)
  // Gasto administrativo fijo compartido entre Veragua y Melcoch (ej. arriendo, nómina
  // administrativa). Se guarda con company="VERAGUA" como ancla, pero el PyG de cada
  // empresa reparte el monto según el % de ventas de ESE mes — ver getPnlRows().
  esCompartido  Boolean         @default(false)
  anulado       Boolean         @default(false)
  anuladoAt     DateTime?
  anuladoPorId  String?
  anuladoPor    User?           @relation("FinTransactionAnuladaPor", fields: [anuladoPorId], references: [id])
  creadoPorId   String
  creadoPor     User            @relation("FinTransactionCreadaPor", fields: [creadoPorId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  compra        FinPurchase?
  venta         FinSale?
  pagoCliente   FinPagoCliente?
  pagoProveedor FinPagoProveedor?

  @@index([company, fecha])
  @@index([company, categoriaId])
  @@index([company, canalId])
}

// Suscripción de notificaciones push del navegador/celular de un usuario.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ============================================================
// INVENTARIO — productos de reventa (Veragua y Melcoch) con foto y catálogo,
// compras a proveedores, ventas a clientes, y Cuentas por Cobrar/Pagar.
// Distinto del modelo `Producto` (solo nombre, para autocompletar Pedidos) y
// del inventario de insumos/recetas de Melcoch (MelcochIngrediente y afines),
// que no se tocan.
// ============================================================

model FinProductCategory {
  id        String   @id @default(cuid())
  company   String // "VERAGUA" | "MELCOCH"
  nombre    String // ej. "Lácteos Sanorigen", "Huevos", "Café"
  createdAt DateTime @default(now())

  productos FinProduct[]

  @@unique([company, nombre])
}

// El stock no se guarda: se calcula igual que computeStocks() de Melcoch
// (compras - ventas + ajustes de conteo). Ver src/lib/inventario/stock.ts.
model FinProduct {
  id               String             @id @default(cuid())
  company          String
  categoriaId      String
  categoria        FinProductCategory @relation(fields: [categoriaId], references: [id])
  nombre           String
  descripcion      String?
  precio           Float
  imagenUrl        String?
  activo           Boolean            @default(true)
  // Agrupa variantes de un mismo producto (ej. "Gelato Premium", "Huevos Marrones").
  // Si es null, el producto se muestra suelto (sin agrupar), como hasta ahora.
  grupo            String?
  // Etiqueta corta de la variante dentro del grupo (ej. "Pistacho Sicilia", "X30").
  // Solo se usa para mostrar cuando `grupo` no es null.
  nombreVariante   String?
  // Producto sin inventario físico (ej. domicilio, café preparado al momento): no se
  // calcula ni se muestra stock, y no entra en las sugerencias de Reabastecimiento.
  esServicio       Boolean            @default(false)
  // Se produce internamente (ej. huevos rojos del galpón): compara la producción
  // registrada en RegistroGalpon contra la demanda en vez de sugerir compras.
  comparaConGalpon Boolean            @default(false)
  // Cuántas unidades del galpón (huevos sueltos) representa 1 unidad de este producto
  // (ej. "Huevos Marrones X30" = 30, "Huevo colorado unidad" = 1). Solo importa si
  // comparaConGalpon = true.
  unidadesGalpon   Int                @default(1)
  creadoPorId      String
  creadoPor        User               @relation("FinProductCreadoPor", fields: [creadoPorId], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  comprasItems FinPurchaseItem[]
  ventasItems  FinSaleItem[]
  ajustes      FinInventoryAdjustment[]
  proveedores  FinProductoProveedor[]
  pronosticos  FinDemandForecast[]

  @@index([company, categoriaId])
}

// Conteo físico / corrección de inventario, igual patrón que MelcochAjusteInventario.
model FinInventoryAdjustment {
  id           String     @id @default(cuid())
  productoId   String
  producto     FinProduct @relation(fields: [productoId], references: [id])
  teoricoAntes Float
  contado      Float
  diferencia   Float
  // Por qué se ajustó (solo en ajustes manuales; los de migración/compensación quedan null).
  motivo       String?
  fecha        DateTime
  creadoPorId  String
  creadoPor    User       @relation("FinInventoryAdjustmentCreadoPor", fields: [creadoPorId], references: [id])
  createdAt    DateTime   @default(now())
}

model Proveedor {
  id        String   @id @default(cuid())
  nombre    String   @unique
  telefono  String?
  contacto  String?
  // "insumos" (proveedor real de productos/servicios) o "financiero" (banco/entidad a la
  // que se le paga un crédito) — distingue a quién sí tiene sentido mandarle un pedido.
  tipo      String   @default("insumos")
  createdAt DateTime @default(now())

  compras         FinPurchase[]
  cuentasPorPagar FinCuentaPorPagar[]
  pagos           FinPagoProveedor[]
  productos       FinProductoProveedor[]
}

// Compra/factura de proveedor (cabecera). Si estado = "pagada" al crearla,
// finTransactionId apunta al gasto generado de una vez; si "pendiente", en
// cambio se crea una FinCuentaPorPagar.
model FinPurchase {
  id               String          @id @default(cuid())
  company          String
  proveedorId      String
  proveedor        Proveedor       @relation(fields: [proveedorId], references: [id])
  fecha            DateTime
  numeroFactura    String?
  estado           String // "pagada" | "pendiente"
  recibido         Boolean         @default(true) // false = pedido hecho pero aún no llega (no suma al stock)
  fechaRecibido    DateTime?
  total            Float
  notas            String?
  finTransactionId String?         @unique
  finTransaction   FinTransaction? @relation(fields: [finTransactionId], references: [id])
  creadoPorId      String
  creadoPor        User            @relation("FinPurchaseCreadoPor", fields: [creadoPorId], references: [id])
  createdAt        DateTime        @default(now())

  items          FinPurchaseItem[]
  cuentaPorPagar FinCuentaPorPagar?

  @@index([company, fecha])
}

model FinPurchaseItem {
  id            String      @id @default(cuid())
  purchaseId    String
  purchase      FinPurchase @relation(fields: [purchaseId], references: [id])
  productoId    String
  producto      FinProduct  @relation(fields: [productoId], references: [id])
  cantidad      Float
  costoUnitario Float
}

// Venta con productos de inventario (cabecera). Igual patrón que FinPurchase:
// "pagada" genera el ingreso de una vez, "pendiente" crea FinCuentaPorCobrar.
model FinSale {
  id               String          @id @default(cuid())
  company          String
  clienteId        String?
  cliente          Cliente?        @relation(fields: [clienteId], references: [id])
  canalId          String?
  canal            FinChannel?     @relation(fields: [canalId], references: [id])
  fecha            DateTime
  estado           String // "pagada" | "pendiente"
  total            Float
  notas            String?
  finTransactionId String?         @unique
  finTransaction   FinTransaction? @relation(fields: [finTransactionId], references: [id])
  creadoPorId      String
  creadoPor        User            @relation("FinSaleCreadoPor", fields: [creadoPorId], references: [id])
  createdAt        DateTime        @default(now())

  items           FinSaleItem[]
  cuentaPorCobrar FinCuentaPorCobrar?

  @@index([company, fecha])
}

model FinSaleItem {
  id             String     @id @default(cuid())
  saleId         String
  sale           FinSale    @relation(fields: [saleId], references: [id])
  productoId     String
  producto       FinProduct @relation(fields: [productoId], references: [id])
  cantidad       Float
  precioUnitario Float
}

// Factura pendiente de cobro a un cliente. saldo = montoTotal - Σ aplicaciones.
model FinCuentaPorCobrar {
  id               String    @id @default(cuid())
  company          String
  clienteId        String
  cliente          Cliente   @relation(fields: [clienteId], references: [id])
  ventaId          String?   @unique
  venta            FinSale?  @relation(fields: [ventaId], references: [id])
  fecha            DateTime
  montoTotal       Float
  saldo            Float
  fechaVencimiento DateTime?
  notas            String?
  creadoPorId      String
  creadoPor        User      @relation("FinCxCCreadoPor", fields: [creadoPorId], references: [id])
  createdAt        DateTime  @default(now())

  aplicaciones FinPagoClienteAplicacion[]

  @@index([company, clienteId])
}

// Un pago de un cliente. Genera un único FinTransaction (base caja) por el
// monto total pagado; cómo se reparte entre facturas queda en las aplicaciones.
model FinPagoCliente {
  id               String         @id @default(cuid())
  clienteId        String
  cliente          Cliente        @relation(fields: [clienteId], references: [id])
  monto            Float
  fecha            DateTime
  metodoPago       String?
  notas            String?
  finTransactionId String         @unique
  finTransaction   FinTransaction @relation(fields: [finTransactionId], references: [id])
  creadoPorId      String
  creadoPor        User           @relation("FinPagoClienteCreadoPor", fields: [creadoPorId], references: [id])
  createdAt        DateTime       @default(now())

  aplicaciones FinPagoClienteAplicacion[]
}

model FinPagoClienteAplicacion {
  id            String             @id @default(cuid())
  pagoId        String
  pago          FinPagoCliente     @relation(fields: [pagoId], references: [id])
  cuentaId      String
  cuenta        FinCuentaPorCobrar @relation(fields: [cuentaId], references: [id])
  montoAplicado Float
  createdAt     DateTime           @default(now())
}

// Espejo exacto de FinCuentaPorCobrar/FinPagoCliente, para proveedores.
model FinCuentaPorPagar {
  id               String       @id @default(cuid())
  company          String
  proveedorId      String
  proveedor        Proveedor    @relation(fields: [proveedorId], references: [id])
  purchaseId       String?      @unique
  purchase         FinPurchase? @relation(fields: [purchaseId], references: [id])
  fecha            DateTime
  montoTotal       Float
  saldo            Float
  fechaVencimiento DateTime?
  notas            String?
  creadoPorId      String
  creadoPor        User         @relation("FinCxPCreadoPor", fields: [creadoPorId], references: [id])
  createdAt        DateTime     @default(now())

  aplicaciones FinPagoProveedorAplicacion[]

  @@index([company, proveedorId])
}

model FinPagoProveedor {
  id               String         @id @default(cuid())
  proveedorId      String
  proveedor        Proveedor      @relation(fields: [proveedorId], references: [id])
  monto            Float
  fecha            DateTime
  metodoPago       String?
  notas            String?
  finTransactionId String         @unique
  finTransaction   FinTransaction @relation(fields: [finTransactionId], references: [id])
  creadoPorId      String
  creadoPor        User           @relation("FinPagoProveedorCreadoPor", fields: [creadoPorId], references: [id])
  createdAt        DateTime       @default(now())

  aplicaciones FinPagoProveedorAplicacion[]
}

model FinPagoProveedorAplicacion {
  id            String            @id @default(cuid())
  pagoId        String
  pago          FinPagoProveedor  @relation(fields: [pagoId], references: [id])
  cuentaId      String
  cuenta        FinCuentaPorPagar @relation(fields: [cuentaId], references: [id])
  montoAplicado Float
  createdAt     DateTime          @default(now())
}

// ============================================================
// REABASTECIMIENTO — lead time por proveedor, inventario de seguridad, punto de
// reorden y pronóstico de demanda (con registro histórico para comparar contra lo
// que realmente pasó). Ver src/lib/inventario/reabastecimiento.ts.
// ============================================================

// Relación producto-proveedor: de dónde se compra, con qué lead time y cada cuánto
// se revisa/pide. Un producto puede tener varias (ej. dos proveedores distintos).
model FinProductoProveedor {
  id                      String     @id @default(cuid())
  productoId              String
  producto                FinProduct @relation(fields: [productoId], references: [id])
  proveedorId             String
  proveedor               Proveedor  @relation(fields: [proveedorId], references: [id])
  leadTimeDias            Int
  diasRevision            Int // cada cuánto se revisa/pide este producto a este proveedor
  costoUnitarioReferencia Float? // solo para prellenar el formulario de compra; no autoritativo
  activo                  Boolean    @default(true)
  createdAt               DateTime   @default(now())

  @@unique([productoId, proveedorId])
}

// Pronóstico calculado en un momento dado, para poder comparar después contra lo que
// realmente se vendió en ese mismo período.
model FinDemandForecast {
  id                  String     @id @default(cuid())
  productoId          String
  producto            FinProduct @relation(fields: [productoId], references: [id])
  calculadoAt         DateTime   @default(now())
  ventanaDias         Int // cuántos días de histórico se usaron para calcularlo
  demandaDiariaProm   Float
  demandaDiariaDesv   Float
  periodoInicio       DateTime // período que se está pronosticando
  periodoFin          DateTime
  demandaPronosticada Float // demandaDiariaProm × días del período
  demandaReal         Float? // se rellena cuando el período ya pasó

  @@index([productoId, periodoFin])
}

// ===== Módulo Vehículo: control de salidas del furgón + rol conductor =====

model Vehiculo {
  id                             String    @id @default(cuid())
  placa                          String    @unique
  marca                          String?
  modelo                         String?
  color                          String?
  soatVenceAt                    DateTime?
  revisionTecnicoMecanicaVenceAt DateTime?
  activo                         Boolean   @default(true)
  createdAt                      DateTime  @default(now())

  // Autorreferencia nullable a la salida actualmente abierta — mecanismo real para
  // "solo una salida abierta por vehículo" (crearSalida/cerrarSalida la leen/escriben
  // dentro de una transacción). Reforzado además con un índice único parcial a nivel
  // de base de datos (ver migración).
  salidaAbiertaId String?         @unique
  salidaAbierta   VehiculoSalida? @relation("VehiculoAbierta", fields: [salidaAbiertaId], references: [id])

  salidas VehiculoSalida[] @relation("VehiculoDeSalida")
}

model VehiculoSalida {
  id          String   @id @default(cuid())
  vehiculoId  String
  vehiculo    Vehiculo @relation("VehiculoDeSalida", fields: [vehiculoId], references: [id])
  conductorId String
  conductor   User     @relation("VehiculoSalidaConductor", fields: [conductorId], references: [id])
  tipoUso     String // "RUTA_EMPRESA" | "ALQUILER"
  zona        String? // "LOCAL" | "PEREIRA" | "MANIZALES", solo si tipoUso = RUTA_EMPRESA
  destino     String?

  checkoutAt              DateTime         @default(now())
  checkoutPorId           String
  checkoutPor             User             @relation("VehiculoCheckoutPor", fields: [checkoutPorId], references: [id])
  checkoutKm              Int
  checkoutCombustible     String // "RESERVA" | "1/4" | "1/2" | "3/4" | "LLENO"
  observacionesEntrega    String?
  firmaConductorEntregaId String?          @unique
  firmaConductorEntrega   VehiculoArchivo? @relation("FirmaConductorEntrega", fields: [firmaConductorEntregaId], references: [id])
  firmaRepEntregaId       String?          @unique
  firmaRepEntrega         VehiculoArchivo? @relation("FirmaRepEntrega", fields: [firmaRepEntregaId], references: [id])

  checkinAt                  DateTime?
  checkinPorId               String?
  checkinPor                 User?            @relation("VehiculoCheckinPor", fields: [checkinPorId], references: [id])
  checkinKm                  Int?
  checkinCombustible         String?
  observacionesDevolucion    String?
  firmaConductorDevolucionId String?          @unique
  firmaConductorDevolucion   VehiculoArchivo? @relation("FirmaConductorDevolucion", fields: [firmaConductorDevolucionId], references: [id])
  firmaRepDevolucionId       String?          @unique
  firmaRepDevolucion         VehiculoArchivo? @relation("FirmaRepDevolucion", fields: [firmaRepDevolucionId], references: [id])

  // Se marca al guardar la acta de devolución — después de esto el registro es de
  // solo lectura salvo notasAdmin, que solo puede editar un admin.
  lockedAt   DateTime?
  notasAdmin String?

  vehiculoAbierto Vehiculo? @relation("VehiculoAbierta")

  fotos        VehiculoFoto[]
  evaluaciones VehiculoEvaluacionPunto[]
  equipamiento VehiculoEquipamientoItem[]
  novedades    VehiculoNovedad[]
  recibos      VehiculoRecibo[]
  danios       VehiculoDanioFinanciero[]
  archivos     VehiculoArchivo[]          @relation("ArchivoDeSalida")
  pedidos      Order[]
  paradas      VehiculoParada[]

  createdAt DateTime @default(now())

  @@index([conductorId, checkoutAt])
  @@index([vehiculoId, checkinAt])
  @@index([checkoutAt])
}

// Checklist de la ruta (paradas que no son pedidos de cliente — ej. dejar insumos o
// recoger producción en una parada intermedia) — una fila por línea del campo "Ruta /
// paradas" del acta de entrega, para que el conductor la pueda ir marcando.
model VehiculoParada {
  id              String         @id @default(cuid())
  salidaId        String
  salida          VehiculoSalida @relation(fields: [salidaId], references: [id])
  orden           Int
  titulo          String
  completado      Boolean        @default(false)
  completadoAt    DateTime?
  completadoPorId String?
  completadoPor   User?          @relation("VehiculoParadaCompletadaPor", fields: [completadoPorId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([salidaId, orden])
}

// Tabla única para todo archivo privado del módulo (fotos, firmas, recibos, remisión
// firmada) — normaliza el acceso detrás de una sola ruta que valida sesión + ownership
// antes de servir el contenido (ver src/app/api/vehiculo/archivo/[archivoId]).
model VehiculoArchivo {
  id           String          @id @default(cuid())
  blobPathname String
  contentType  String
  // Denormalizado aquí (no resuelto solo vía join) para que la ruta que sirve el
  // archivo pueda chequear ownership con una sola consulta.
  salidaId     String?
  salida       VehiculoSalida? @relation("ArchivoDeSalida", fields: [salidaId], references: [id])
  subidoPorId  String
  subidoPor    User            @relation("VehiculoArchivoSubidoPor", fields: [subidoPorId], references: [id])
  createdAt    DateTime        @default(now())

  foto                       VehiculoFoto?
  recibo                     VehiculoRecibo?
  firmaConductorEntregaDe    VehiculoSalida? @relation("FirmaConductorEntrega")
  firmaRepEntregaDe          VehiculoSalida? @relation("FirmaRepEntrega")
  firmaConductorDevolucionDe VehiculoSalida? @relation("FirmaConductorDevolucion")
  firmaRepDevolucionDe       VehiculoSalida? @relation("FirmaRepDevolucion")
  entregaDe                  Order[]
}

// Las 7 fotos de ángulo fijo, necesarias en entrega Y devolución (comparación lado a
// lado). Ángulos en src/lib/vehiculo/constants.ts.
model VehiculoFoto {
  id        String          @id @default(cuid())
  salidaId  String
  salida    VehiculoSalida  @relation(fields: [salidaId], references: [id])
  momento   String // "ENTREGA" | "DEVOLUCION"
  angulo    String
  archivoId String          @unique
  archivo   VehiculoArchivo @relation(fields: [archivoId], references: [id])
  createdAt DateTime        @default(now())

  @@unique([salidaId, momento, angulo])
}

// Los 8 puntos de evaluación, también en ambos momentos. Puntos en constants.ts.
model VehiculoEvaluacionPunto {
  id        String         @id @default(cuid())
  salidaId  String
  salida    VehiculoSalida @relation(fields: [salidaId], references: [id])
  momento   String
  punto     String
  estado    String // "BUENO" | "REGULAR" | "MALO"
  nota      String? // obligatoria en el server action si estado != "BUENO"
  createdAt DateTime       @default(now())

  @@unique([salidaId, momento, punto])
}

// Checklist sí/no de dotación, también en ambos momentos. Items en constants.ts.
model VehiculoEquipamientoItem {
  id        String         @id @default(cuid())
  salidaId  String
  salida    VehiculoSalida @relation(fields: [salidaId], references: [id])
  momento   String
  item      String
  presente  Boolean
  createdAt DateTime       @default(now())

  @@unique([salidaId, momento, item])
}

// Solo devolución — exactamente 2 filas posibles por salida.
model VehiculoNovedad {
  id        String         @id @default(cuid())
  salidaId  String
  salida    VehiculoSalida @relation(fields: [salidaId], references: [id])
  tipo      String // "DANOS_NUEVOS" | "COMPARENDOS_INCIDENTES"
  marcado   Boolean        @default(false)
  detalle   String? // obligatorio en el server action si marcado = true
  createdAt DateTime       @default(now())

  @@unique([salidaId, tipo])
}

// Recibos de tanqueo/peaje — se cargan incrementalmente durante el viaje, incluso por
// el conductor desde su celular.
model VehiculoRecibo {
  id            String          @id @default(cuid())
  salidaId      String
  salida        VehiculoSalida  @relation(fields: [salidaId], references: [id])
  tipo          String // "COMBUSTIBLE" | "PEAJE"
  valor         Int
  galonesOLugar String?
  archivoId     String          @unique
  archivo       VehiculoArchivo @relation(fields: [archivoId], references: [id])
  subidoPorId   String
  subidoPor     User            @relation("VehiculoReciboSubidoPor", fields: [subidoPorId], references: [id])
  createdAt     DateTime        @default(now())

  @@index([salidaId])
}

// Ledger de daños/multas — lo registra un admin a mano desde el detalle de la salida.
model VehiculoDanioFinanciero {
  id          String         @id @default(cuid())
  salidaId    String
  salida      VehiculoSalida @relation(fields: [salidaId], references: [id])
  // Denormalizado para las consultas mensuales por conductor.
  conductorId String
  conductor   User           @relation("VehiculoDanioConductor", fields: [conductorId], references: [id])
  valor       Int
  concepto    String
  estado      String // "PENDIENTE" | "DESCONTADO" | "PAGADO"
  creadoPorId String
  creadoPor   User           @relation("VehiculoDanioCreadoPor", fields: [creadoPorId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([conductorId, createdAt])
}

// Singleton, mismo patrón que CajaSettings.
model VehiculoSettings {
  id                  String   @id @default("singleton")
  valorPorRuta        Int      @default(0)
  canonDiarioAlquiler Int      @default(0)
  updatedAt           DateTime @updatedAt
}
