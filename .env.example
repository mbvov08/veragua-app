# Supabase: botón "Connect" arriba del proyecto → pestaña "ORMs" → Prisma.
# Copia ambas líneas tal cual te las da Supabase (reemplazando [YOUR-PASSWORD]).
DATABASE_URL="postgresql://usuario:contraseña@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:contraseña@host:5432/postgres"

# Clave secreta para firmar las sesiones. Genera una nueva con: openssl rand -base64 32
AUTH_SECRET=""

# Notificaciones push (Web Push / VAPID). Genera un par con:
# node -e "..." (ver conversación) o `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@veragua.co"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Fotos de producto (Inventario). Panel de Vercel del proyecto → Storage → Create → Blob;
# esto se inyecta solo en producción, para probar en local copia aquí ese mismo token.
BLOB_READ_WRITE_TOKEN=""
