# Supabase: botón "Connect" arriba del proyecto → pestaña "ORMs" → Prisma.
# Copia ambas líneas tal cual te las da Supabase (reemplazando [YOUR-PASSWORD]).
DATABASE_URL="postgresql://usuario:contraseña@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:contraseña@host:5432/postgres"

# Clave secreta para firmar las sesiones. Genera una nueva con: openssl rand -base64 32
AUTH_SECRET=""
